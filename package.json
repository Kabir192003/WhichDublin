{
  "name": "which-dublin",
  "version": "0.1.0",
  "private": true,
  "description": "Compare Dublin districts by rent, real commute time and commute reliability, relative to your campus.",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "validate": "node pipeline/validate.js",
    "data:personas": "node pipeline/make-personas.js",
    "data:fetch": "node pipeline/fetch-sources.js",
    "dev": "vite",
    "build": "node pipeline/validate.js && vite build",
    "preview": "vite preview",
    "data:compute": "node pipeline/compute.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "maplibre-gl": "^4.7.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^5.4.11"
  }
}
